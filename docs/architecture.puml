@startuml
skinparam linetype ortho
skinparam nodesep 70
skinparam ranksep 45

package "es.upm.poo" as root {

class App {
  + {static} main(args: String[])
}

package configuration {
}

package presentation {

  class ErrorHandler

  package "exceptions" as presentation_exceptions {
  }

  package "cli" as cli {
    class CommandLineInterface
    interface Command
    class CommandParams

    package "commands" as commands {
      class XCommand
      note as NC
        XCommand = cada comando
        (CreateUser, FindAllUsers...)
      end note
    }
  }

  package "view" as view {
    class View
    enum AnsiCode
  }
}

package services {
  class XService

  package "exceptions" as services_exceptions {
  }
}

package data {

  package "repositories" as repositories {
    interface GenericRepository<T>
    interface XRepository
    note as N
      X = User, Consent, Park,
      Zone, Attraction, Ticket
    end note

    package "map" as map {
      abstract class GenericRepositoryMap<T>
      class XRepositoryMap
    }
  }

  package "model" as model {
    class Park {
      - id: Long
      - name: String
      - address: String
      - openingTime: LocalTime
      - closingTime: LocalTime
    }
    class Zone {
      - id: Long
      - name: String
      - theme: String
    }
    class Attraction {
      - id: Long
      - name: String
      - minHeightCm: Integer
      - capacity: Integer
    }
    class Ticket {
      - id: Long
      - ticketType: TicketType
      - price: BigDecimal
      - purchaseDate: LocalDate
      - validDate: LocalDate
    }
    enum TicketType {
      STANDARD
      FAST_PASS
    }
    class Consent {
      - id: Long
      - grantedAt: LocalDateTime
      - source: String
      - purpose: ConsentPurpose
      - revokedAt: LocalDateTime
    }
    enum ConsentPurpose {
      BASIC
      MARKETING
      ALL
    }
    class User {
      - id: Long
      - name: String
      - email: String {unique}
      - dateOfBirth: LocalDate
      - gender: Gender
      - active: Boolean
    }
    enum Gender {
      MALE
      FEMALE
      NON_BINARY
      OTHER
      PREFER_NOT_TO_SAY
    }
  }
}

}

' ---------- Herencia e implementación ----------




' ---------- Comandos (a nivel de paquete) ----------

' ---------- Servicios, repositorios y map ----------
GenericRepository <|-- XRepository
GenericRepository <|.. GenericRepositoryMap
GenericRepositoryMap <|-- XRepositoryMap
XRepository <|.. XRepositoryMap
XService -down-> XRepository
Command <|.. XCommand
XCommand -right-> View
XCommand -down-> XService
NC .. XCommand
N .. XRepository


' ---------- Asociaciones (atributo) ----------
CommandLineInterface -right-> View
CommandLineInterface "1" -down-> "0..*" Command



' ---------- Modelo ----------
Park "1" *-right---> "1..*" Zone : dividido
Zone "1" o-down-> "0..*" Attraction : agrupa
Ticket "0..*" -up-> "1" Park : acceso
Ticket "0..*" -down-> "1" User : comprado
Consent "1" o-right-> "1" User : user
Ticket -left-> TicketType
Consent -down-> ConsentPurpose
User -down-> Gender

' ---------- Disposición (oculta) ----------

CommandParams -[hidden]down- ErrorHandler
GenericRepositoryMap -[hidden]down- Park
View -[hidden]right- AnsiCode
TicketType -[hidden]down- Consent
XCommand -[hidden]down- XService
@enduml
