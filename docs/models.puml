@startuml
package data.models {
enum Gender {
  MALE
  FEMALE
  NON_BINARY
  OTHER
  PREFER_NOT_TO_SAY
}

class Consent {
  -id : Long
  -consentDate : LocalDate
  -policyVersion : String
  -DataProcessingAccepted : boolean
  -AdvertisingAccepted : boolean
}

class User {
  -id : Long
  -name : String
  -email : String {unique}
  -dateOfBirth : LocalDate
  -gender : Gender
  -active : Boolean
}

Consent "1" <--* "1" User
}

@enduml